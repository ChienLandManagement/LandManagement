{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.PostgreSQL.Configuration"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.AspNetCore.HttpLogging": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=localhost;Port=5432;Database=landmanagement;Username=postgres;Password=postgres",
          "tableName": "error_logs",
          "needAutoCreateTable": true,
          "configurationPath": "Serilog"
        }
      }
    ],
    "Columns": {
      "id": {
        "Name": "SinglePropertyColumnWriter",
        "Args": {
          "propertyName": "LogId",
          "writeMethod": "ToString",
          "dbType": "Varchar"
        }
      },
      "message": "RenderedMessageColumnWriter",
      "message_template": "MessageTemplateColumnWriter",
      "level": {
        "Name": "LevelColumnWriter",
        "Args": {
          "renderAsText": true,
          "dbType": "Varchar"
        }
      },
      "raise_date": "TimestampColumnWriter",
      "exception": "ExceptionColumnWriter",
      "properties": "LogEventSerializedColumnWriter",
      "machine_name": {
        "Name": "SinglePropertyColumnWriter",
        "Args": {
          "propertyName": "MachineName",
          "writeMethod": "ToString"
        }
      }
    },
    "Properties": {
      "Application": "LandManagement.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=landmanagement;Username=postgres;Password=postgres"
  },
  "Mail": {
    "Host": "",
    "Port": 587,
    "UseAuthentication": true,
    "Username": "",
    "Password": ""
  },
  "SeaweedS3": {
    "ServiceUrl": "http://localhost:8333",
    "BucketName": "landmanagement",
    "AccessKey": "any",
    "SecretKey": "any",
    "UrlExpiryMinutes": 15,
    "MaxFileSizeMB": 50
  },
  "Google": {
    "ClientId": ""
  }
}
