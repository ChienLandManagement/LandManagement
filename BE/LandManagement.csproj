<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LandManagement</RootNamespace>
    <!-- RazorLight biên dịch template lúc runtime bằng Roslyn nên cần metadata reference của assembly entry. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <!-- Razor SDK mặc định loại .cshtml khỏi thư mục publish; template email phải mang theo khi publish. -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.1.2.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ChienDeepEyes.ResultLib" Version="2.5.4" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="ErrorOr" Version="2.1.1" />
    <PackageReference Include="FastEndpoints" Version="9.0.0" />
    <PackageReference Include="FastEndpoints.Security" Version="9.0.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="9.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="MediatR" Version="15.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="11.0.0" />
    <PackageReference Include="MyCSharp.HttpUserAgentParser" Version="3.1.6" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL" Version="2.3.0" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL.Configuration" Version="1.0.1" />
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Danh mục chuẩn (TT 08/2024) nạp lần đầu khi bảng còn trống; bản gốc ở docs/data. -->
    <EmbeddedResource Include="Data\SeedData\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template cshtml cho RazorLight nạp từ disk lúc chạy. -->
    <None Include="Resources\Templates\**\*.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
