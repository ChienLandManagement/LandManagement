    "typecheck": "tsc -b --pretty",
    "gen:api": "orval",
    "check:deps": "node scripts/check-deps.mjs",
    "guard": "node scripts/ds-guard.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@mantine/charts": "^9.8.2",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "jwt-decode": "^4.0.0",
    "ky": "^2.2.0",
    "lucide-react": "^1.81.0",
